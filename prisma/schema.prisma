generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Author {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bds           BdAuthor[]
  events        AuthorEvent[]
  name          String        @unique @db.VarChar(255)
  bio           String?       @db.Text
  bio_source    String?       @db.VarChar(50)
  photo_url     String?       @db.Text
  wikipedia_url String?       @db.Text
  website       String?       @db.Text
}

model Publisher {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String      @unique @db.VarChar(255)
  parentId String?     @db.Uuid
  parent   Publisher?  @relation("PublisherImprints", fields: [parentId], references: [id])
  imprints Publisher[] @relation("PublisherImprints")
  bds      Bd[]
}

model Genre {
  id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String    @unique @db.VarChar(100)
  bds  BdGenre[]
}

model Bd {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  events           BdEvent[]
  authors          BdAuthor[]
  genres           BdGenre[]
  title            String      @unique @db.VarChar(255)
  publisher        String?
  publisherId      String?     @db.Uuid
  publisherRef     Publisher?  @relation(fields: [publisherId], references: [id])
  publishing_year  Int?
  ean              String?     @db.VarChar(13)
  summary          String?     @db.Text
  publication_date DateTime?   @db.Date
  page_count       Int?
  price            Decimal?    @db.Decimal(10, 2)
  cover_url          String?   @db.Text
  publisher_url      String?   @db.Text
  leslibraires_url   String?   @db.Text
  enrichment_source  String?   @db.VarChar(50)
}

model Event {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String        @unique @db.VarChar(255)
  bds      BdEvent[]
  authors  AuthorEvent[]
  date     DateTime      @unique @db.Date
  hour     String?       @db.VarChar(5)
  place    String?       @db.VarChar(255)
  fb_event  String?
  cover_url String?  @db.Text
}

model BdAuthor {
  bd       Bd     @relation(fields: [bdId], references: [id])
  bdId     String @db.Uuid
  author   Author @relation(fields: [authorId], references: [id])
  authorId String @db.Uuid

  @@id([authorId, bdId])
}

model AuthorEvent {
  author   Author @relation(fields: [authorId], references: [id])
  event    Event  @relation(fields: [eventId], references: [id])
  authorId String @db.Uuid
  eventId  String @db.Uuid

  @@id([authorId, eventId])
}

model BdEvent {
  bd      Bd     @relation(fields: [bdId], references: [id])
  bdId    String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @db.Uuid

  @@id([bdId, eventId])
}

model BdGenre {
  bd      Bd     @relation(fields: [bdId], references: [id])
  bdId    String @db.Uuid
  genre   Genre  @relation(fields: [genreId], references: [id])
  genreId String @db.Uuid

  @@id([bdId, genreId])
}

model InstagramPost {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortcode String  @unique @db.VarChar(50)
  type      String? @default("post") @db.VarChar(10)
  position  Int
  active    Boolean @default(true)
}

model WizardDraft {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  name      String   @default("Brouillon") @db.VarChar(255)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([email])
}

// Singleton: exactly one row, keyed by `key` so writes are a plain upsert.
// Hidden (404 + no nav link) until an admin flips `active`.
model LegalPage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @default("legal") @db.VarChar(50)
  active    Boolean  @default(false)
  contentFr String?  @db.Text
  contentEn String?  @db.Text
  updatedAt DateTime @updatedAt
}

// Cards on the public contact page. `kind` drives the href scheme and
// validation, `icon` only drives the glyph. English copy is optional and
// falls back to French.
model ContactSection {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind     String  @db.VarChar(10)
  // Null means "no explicit choice" — the glyph is then derived from the kind,
  // so a mail section never falls back to a chain-link icon.
  icon     String? @db.VarChar(20)
  titleFr  String  @db.VarChar(120)
  titleEn  String? @db.VarChar(120)
  textFr   String  @db.VarChar(200)
  textEn   String? @db.VarChar(200)
  value    String  @db.VarChar(500)
  position Int
  active   Boolean @default(true)

  @@index([position])
}
